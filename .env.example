# Copy to .env in the repo root. Never commit .env.
#   cp .env.example .env

# WordPress REST (Application Password, not the wp-admin login password)
WP_BASE=https://rukn-eltatawer.com/om
WP_USER=mahmoud
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional. Only needed for --inspect-keys / --scan-empty via the post editor.
WP_ADMIN_PASSWORD=

# WhatsApp digits only. Keep the UAE number; do not switch to +968.
WP_WHATSAPP=971586634710

# LLM. Set at least one. --provider auto prefers OpenAI then Gemini.
# Use --offline to skip the LLM and fill from templates (good for dry-runs).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_PROVIDER=auto

# Optional overrides if your meta keys differ from the Kayan defaults.
# WRITE_MODE=kayan
# FEATURES_META_KEY=post__features__data
# STEPS_META_KEY=post__work_steps__data
# PRICES_META_KEY=post__price_list__data
# SERVICES_META_KEY=post__services__data
# CALL_META_KEY=post__call_section__data
